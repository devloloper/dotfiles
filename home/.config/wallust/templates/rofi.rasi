* {
    background: {{background}};
    foreground: {{foreground}};
    color0: {{color0}};
    color1: {{color1}};
    color2: {{color2}};
    color3: {{color3}};
    color4: {{color4}};
    color5: {{color5}};
    color6: {{color6}};
    color7: {{color7}};
    color8: {{color8}};
    color9: {{color9}};
    color10: {{color10}};
    color11: {{color11}};
    color12: {{color12}};
    color13: {{color13}};
    color14: {{color14}};
    color15: {{color15}};

    /* Standard Rofi color names */
    selected-active-background: {{color11}};
    selected-active-foreground: {{background}};
    selected-normal-background: {{color11}};
    selected-normal-foreground: {{background}};
    selected-urgent-background: {{color9}};
    selected-urgent-foreground: {{background}};

    border-color: {{color11}};
    separatorcolor: {{color8}};
}
