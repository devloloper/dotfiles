#!/bin/sh
set -eu

config="${XDG_CONFIG_HOME:-$HOME/.config}/BambuStudio/BambuStudio.conf"

if [ -f "$config" ]; then
    layout='layout2|name=sidebar;caption=;state=1932;dir=4;layer=0;row=0;pos=0;prop=100000;bestw=590;besth=1260;minw=210;minh=800;maxw=-1;maxh=-1;floatx=-1;floaty=-1;floatw=-1;floath=-1|name=main;caption=;state=256;dir=5;layer=0;row=0;pos=0;prop=100000;bestw=7000;besth=1260;minw=800;minh=800;maxw=-1;maxh=-1;floatx=-1;floaty=-1;floatw=-1;floath=-1|dock_size(4,0,0)=590|dock_size(5,0,0)=7000|'

    BAMBU_LAYOUT="$layout" perl -0pi -e '
        my $layout = $ENV{"BAMBU_LAYOUT"};
        s/"window_layout":\s*"[^"]*"/"window_layout": "$layout"/s;
        s/"window_mainframe":\s*"[^"]*"/"window_mainframe": "3; 3; 7674; 2114; 0"/s;
        s/"enable_bvh":\s*true/"enable_bvh": false/s;
        s/"enable_opengl_multi_instance":\s*true/"enable_opengl_multi_instance": false/s;
        s/"show_model_mesh":\s*false/"show_model_mesh": true/s;
    ' "$config"
fi

case "${BAMBU_RENDER_BACKEND:-zink}" in
    software)
        exec env \
            __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json \
            LIBGL_ALWAYS_SOFTWARE=1 \
            WEBKIT_DISABLE_DMABUF_RENDERER=1 \
            WEBKIT_FORCE_COMPOSITING_MODE=1 \
            WEBKIT_DISABLE_COMPOSITING_MODE=1 \
            /usr/bin/bambu-studio "$@"
        ;;
    native)
        exec env \
            __GLX_VENDOR_LIBRARY_NAME=nvidia \
            WEBKIT_DISABLE_DMABUF_RENDERER=1 \
            WEBKIT_FORCE_COMPOSITING_MODE=1 \
            WEBKIT_DISABLE_COMPOSITING_MODE=1 \
            /usr/bin/bambu-studio "$@"
        ;;
    zink|*)
        exec env \
            GDK_BACKEND=wayland \
            QT_QPA_PLATFORM=wayland \
            __GLX_VENDOR_LIBRARY_NAME=mesa \
            __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json \
            MESA_LOADER_DRIVER_OVERRIDE=zink \
            GALLIUM_DRIVER=zink \
            WEBKIT_DISABLE_DMABUF_RENDERER=1 \
            /usr/bin/bambu-studio "$@"
        ;;
esac
